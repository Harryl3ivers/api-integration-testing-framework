        {
          "name": "Get Booking By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Updated first name is correct\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.firstname).to.eql(\"James\");\n});\n\npm.test(\"Updated last name is correct\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.lastname).to.eql(\"Smith\");\n});\n\npm.test(\"Updated price is correct\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.totalprice).to.eql(150);\n});\n\npm.test(\"Updated deposit status is correct\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.depositpaid).to.eql(false);\n});\n\npm.test(\"Updated additional needs are correct\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.additionalneeds).to.eql(\"Lunch\");\n});\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});"
                ]
              }
            }
          ],
