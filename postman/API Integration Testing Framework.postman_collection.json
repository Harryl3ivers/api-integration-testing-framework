                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking ID is returned\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response).to.have.property(\"bookingid\");\r\n});\r\n\r\npm.test(\"Booking details are correct\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.booking.firstname).to.eql(\"John\");\r\n    pm.expect(response.booking.lastname).to.eql(\"Smith\");\r\n    pm.expect(response.booking.totalprice).to.eql(100);\r\n    pm.expect(response.booking.depositpaid).to.eql(true);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.environment.set(\r\n    \"booking_id\",\r\n    response.bookingid\r\n);"
